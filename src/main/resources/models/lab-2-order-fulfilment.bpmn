<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Order" targetNamespace="http://camunda.io/labs">
  <bpmn:process id="order-fulfilment" name="Lab 2 — E-Commerce Order Fulfilment" isExecutable="true">
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="stock" name="Validate order &amp; reserve stock"><bpmn:extensionElements><zeebe:taskDefinition type="validate-order-and-stock" retries="3"/></bpmn:extensionElements><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="availability" name="Stock available?"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing><bpmn:outgoing>f4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="outOfStock" name="Order stopped — no stock"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
    <bpmn:businessRuleTask id="priority" name="Determine delivery priority"><bpmn:extensionElements><zeebe:calledDecision decisionId="order-priority" resultVariable="deliveryPriority"/></bpmn:extensionElements><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:serviceTask id="payment" name="Mock payment gateway"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3"/></bpmn:extensionElements><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="paid" name="Payment approved?"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing><bpmn:outgoing>f8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="declined" name="Order stopped — payment declined"><bpmn:incoming>f7</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="reviewNeeded" name="High-value or exception?"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="review" name="Manual order verification"><bpmn:extensionElements><zeebe:assignmentDefinition assignee="order-reviewer"/></bpmn:extensionElements><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="fulfilled" name="Release to fulfilment"><bpmn:incoming>f10</bpmn:incoming><bpmn:incoming>f11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="stock"/><bpmn:sequenceFlow id="f2" sourceRef="stock" targetRef="availability"/>
    <bpmn:sequenceFlow id="f3" sourceRef="availability" targetRef="outOfStock"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=stockAvailable = false</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="availability" targetRef="priority"/><bpmn:sequenceFlow id="f5" sourceRef="priority" targetRef="payment"/><bpmn:sequenceFlow id="f6" sourceRef="payment" targetRef="paid"/>
    <bpmn:sequenceFlow id="f7" sourceRef="paid" targetRef="declined"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=paymentStatus = "DECLINED"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f8" sourceRef="paid" targetRef="reviewNeeded"/><bpmn:sequenceFlow id="f9" sourceRef="reviewNeeded" targetRef="review"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=orderTotal &gt;= 10000</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" sourceRef="reviewNeeded" targetRef="fulfilled"/><bpmn:sequenceFlow id="f11" sourceRef="review" targetRef="fulfilled"/>
  </bpmn:process>
</bpmn:definitions>
