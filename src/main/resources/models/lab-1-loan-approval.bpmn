<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Loan" targetNamespace="http://camunda.io/labs">
  <bpmn:process id="loan-approval" name="Lab 1 — Loan Approval" isExecutable="true">
    <bpmn:startEvent id="start" name="Application received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="validate" name="Validate applicant information">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-loan-application" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="valid" name="Application valid?" default="f4">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="invalid" name="Rejected — invalid data">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="credit" name="Mock credit assessment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;POST&quot;" target="method" />
          <zeebe:input source="=&quot;http://localhost:8081/mock/credit-assessments&quot;" target="url" />
          <zeebe:input source="={&quot;type&quot;:&quot;noAuth&quot;}" target="authentication" />
          <zeebe:input source="={&quot;syntheticCreditScore&quot;: if is defined(syntheticCreditScore) then syntheticCreditScore else 700, &quot;simulateFailure&quot;: if is defined(simulateFailure) then simulateFailure else false}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={creditScore: response.body.creditScore, creditStatus: response.body.creditStatus}" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="decision" name="Evaluate loan decision">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="loan-decision" resultVariable="loanDecision" />
      </bpmn:extensionElements>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="route" name="Decision route" default="f9">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="review" name="Manual loan review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="approved" name="Loan approved">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="rejected" name="Loan rejected">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="validate" />
    <bpmn:sequenceFlow id="f2" sourceRef="validate" targetRef="valid" />
    <bpmn:sequenceFlow id="f3" name="No" sourceRef="valid" targetRef="invalid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=applicationValid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" name="Yes" sourceRef="valid" targetRef="credit" />
    <bpmn:sequenceFlow id="f5" sourceRef="credit" targetRef="decision" />
    <bpmn:sequenceFlow id="f6" sourceRef="decision" targetRef="route" />
    <bpmn:sequenceFlow id="f7" name="Approved" sourceRef="route" targetRef="approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loanDecision = "Approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f8" name="Manual Review" sourceRef="route" targetRef="review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loanDecision = "Manual Review"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f9" name="Rejected" sourceRef="route" targetRef="rejected" />
    <bpmn:sequenceFlow id="f10" sourceRef="review" targetRef="approved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_loan">
    <bpmndi:BPMNPlane id="BPMNPlane_loan" bpmnElement="loan-approval">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="160" y="212" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validate_di" bpmnElement="validate"><dc:Bounds x="250" y="190" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="valid_di" bpmnElement="valid" isMarkerVisible="true"><dc:Bounds x="470" y="205" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="invalid_di" bpmnElement="invalid"><dc:Bounds x="477" y="370" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="credit_di" bpmnElement="credit"><dc:Bounds x="580" y="190" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decision_di" bpmnElement="decision"><dc:Bounds x="810" y="190" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="route_di" bpmnElement="route" isMarkerVisible="true"><dc:Bounds x="1040" y="205" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approved_di" bpmnElement="approved"><dc:Bounds x="1280" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_di" bpmnElement="review"><dc:Bounds x="1160" y="190" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rejected_di" bpmnElement="rejected"><dc:Bounds x="1047" y="370" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="196" y="230" /><di:waypoint x="250" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="420" y="230" /><di:waypoint x="470" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="495" y="255" /><di:waypoint x="495" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="520" y="230" /><di:waypoint x="580" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="750" y="230" /><di:waypoint x="810" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="980" y="230" /><di:waypoint x="1040" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="1065" y="205" /><di:waypoint x="1065" y="118" /><di:waypoint x="1280" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="1090" y="230" /><di:waypoint x="1160" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="1065" y="255" /><di:waypoint x="1065" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="1240" y="190" /><di:waypoint x="1240" y="118" /><di:waypoint x="1280" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>