<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Triage" targetNamespace="http://camunda.io/labs">
  <bpmn:process id="patient-triage" name="Lab 3 — Hospital Appointment and Triage" isExecutable="true">
    <bpmn:startEvent id="start" name="Request received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="register" name="Validate registration">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-registration-and-availability" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="triage" name="Classify triage urgency">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="triage-decision" resultVariable="triageCategory" />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="category" name="Triage category" default="fRoutine">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>fUrgent</bpmn:outgoing>
      <bpmn:outgoing>fPriority</bpmn:outgoing>
      <bpmn:outgoing>fRoutine</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="urgentReview" name="Immediate clinical assessment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>fUrgent</bpmn:incoming>
      <bpmn:outgoing>fUrgentDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="priorityReview" name="Priority staff review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>fPriority</bpmn:incoming>
      <bpmn:outgoing>fPriorityDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="schedule" name="Mock scheduling API">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;POST&quot;" target="method" />
          <zeebe:input source="=&quot;http://localhost:8081/mock/appointments&quot;" target="url" />
          <zeebe:input source="={&quot;type&quot;:&quot;noAuth&quot;}" target="authentication" />
          <zeebe:input source="={&quot;slotMode&quot;: if is defined(slotMode) then slotMode else &quot;available&quot;, &quot;simulateFailure&quot;: if is defined(simulateFailure) then simulateFailure else false}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={slotAvailable: response.body.slotAvailable, availableSlot: response.body.availableSlot}" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>fRoutine</bpmn:incoming>
      <bpmn:incoming>fPriorityDone</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="slot" name="Slot available?" default="fBooked">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>fNoSlot</bpmn:outgoing>
      <bpmn:outgoing>fBooked</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="staffReview" name="Staff scheduling review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>fNoSlot</bpmn:incoming>
      <bpmn:outgoing>fStaffDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="booked" name="Request closed">
      <bpmn:incoming>fBooked</bpmn:incoming>
      <bpmn:incoming>fStaffDone</bpmn:incoming>
      <bpmn:incoming>fUrgentDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="register" />
    <bpmn:sequenceFlow id="f2" sourceRef="register" targetRef="triage" />
    <bpmn:sequenceFlow id="f3" sourceRef="triage" targetRef="category" />
    <bpmn:sequenceFlow id="fUrgent" name="Urgent" sourceRef="category" targetRef="urgentReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageCategory = "Urgent Assessment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fPriority" name="Priority" sourceRef="category" targetRef="priorityReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageCategory = "Priority Review"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fRoutine" name="Routine" sourceRef="category" targetRef="schedule" />
    <bpmn:sequenceFlow id="fPriorityDone" sourceRef="priorityReview" targetRef="schedule" />
    <bpmn:sequenceFlow id="f6" sourceRef="schedule" targetRef="slot" />
    <bpmn:sequenceFlow id="fNoSlot" name="No" sourceRef="slot" targetRef="staffReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotAvailable = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fBooked" name="Yes" sourceRef="slot" targetRef="booked" />
    <bpmn:sequenceFlow id="fStaffDone" sourceRef="staffReview" targetRef="booked" />
    <bpmn:sequenceFlow id="fUrgentDone" sourceRef="urgentReview" targetRef="booked" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_triage">
    <bpmndi:BPMNPlane id="BPMNPlane_triage" bpmnElement="patient-triage">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="140" y="242" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="register_di" bpmnElement="register"><dc:Bounds x="230" y="220" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="triage_di" bpmnElement="triage"><dc:Bounds x="440" y="220" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="category_di" bpmnElement="category" isMarkerVisible="true"><dc:Bounds x="660" y="235" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="urgentReview_di" bpmnElement="urgentReview"><dc:Bounds x="780" y="80" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="priorityReview_di" bpmnElement="priorityReview"><dc:Bounds x="780" y="360" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="schedule_di" bpmnElement="schedule"><dc:Bounds x="860" y="220" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="slot_di" bpmnElement="slot" isMarkerVisible="true"><dc:Bounds x="1080" y="235" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="staffReview_di" bpmnElement="staffReview"><dc:Bounds x="1180" y="360" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="booked_di" bpmnElement="booked"><dc:Bounds x="1320" y="242" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="176" y="260" /><di:waypoint x="230" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="390" y="260" /><di:waypoint x="440" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="610" y="260" /><di:waypoint x="660" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fUrgent_di" bpmnElement="fUrgent"><di:waypoint x="685" y="235" /><di:waypoint x="685" y="120" /><di:waypoint x="780" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fPriority_di" bpmnElement="fPriority"><di:waypoint x="685" y="285" /><di:waypoint x="685" y="400" /><di:waypoint x="780" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fRoutine_di" bpmnElement="fRoutine"><di:waypoint x="710" y="260" /><di:waypoint x="860" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fPriorityDone_di" bpmnElement="fPriorityDone"><di:waypoint x="960" y="400" /><di:waypoint x="945" y="400" /><di:waypoint x="945" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="1030" y="260" /><di:waypoint x="1080" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fNoSlot_di" bpmnElement="fNoSlot"><di:waypoint x="1105" y="285" /><di:waypoint x="1105" y="400" /><di:waypoint x="1180" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fBooked_di" bpmnElement="fBooked"><di:waypoint x="1130" y="260" /><di:waypoint x="1320" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fStaffDone_di" bpmnElement="fStaffDone"><di:waypoint x="1370" y="400" /><di:waypoint x="1338" y="400" /><di:waypoint x="1338" y="278" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fUrgentDone_di" bpmnElement="fUrgentDone"><di:waypoint x="970" y="120" /><di:waypoint x="1338" y="120" /><di:waypoint x="1338" y="242" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
